// ─── DRAW IXP NODES ──────────────────────────────────
function drawIXPs() {
  ixpLayer.clearLayers();
  IXPs.forEach(ix => {
    const col  = ix.tier===1 ? '#38BDF8' : ix.tier===2 ? '#818CF8' : '#F59E0B';
    const r    = ix.tier===1 ? 12 : ix.tier===2 ? 8 : 6;
    const glow = ix.tier===1 ? `drop-shadow(0 0 6px ${col})` : 'none';

    // Pulse ring for Tier-1 (outer glow ring)
    if (ix.tier === 1) {
      const ring = L.circleMarker([ix.lat, ix.lon], {
        radius: r + 8, color: col, weight: 1,
        fillColor: 'transparent', fillOpacity: 0,
        opacity: 0.35,
        className: `ixp-ring tier-${ix.tier}`
      });
      ring.addTo(ixpLayer);

      const ring2 = L.circleMarker([ix.lat, ix.lon], {
        radius: r + 16, color: col, weight: 0.5,
        fillColor: 'transparent', fillOpacity: 0,
        opacity: 0.15,
        className: `ixp-ring2 tier-${ix.tier}`
      });
      ring2.addTo(ixpLayer);
    }

    const marker = L.circleMarker([ix.lat, ix.lon], {
      radius: r, color: col, weight: 2,
      fillColor: col, fillOpacity: 1.0,
      className: `ixp-node tier-${ix.tier}`
    });

    // Tooltip (hover)
    marker.on('mouseover', function(e) {
      const tp = document.getElementById('tip');
      document.getElementById('tt-name').textContent = ix.name;
      document.getElementById('tt-body').innerHTML = `
        <div class="tr"><span>Country</span><span>${ix.country}</span></div>
        <div class="tr"><span>City</span><span>${ix.city}</span></div>
        <div class="tr"><span>Members</span><span>${ix.member_count}+ networks</span></div>
        <div class="tr"><span>Peak Traffic</span><span>${ix.traffic_peak_tbps} Tbps</span></div>
        <div class="tr"><span>Tier</span><span>T${ix.tier}</span></div>
        <div style="font-size:9px;color:var(--muted);margin-top:5px">Click to open facility card</div>`;
      const pt  = map.latLngToContainerPoint([ix.lat, ix.lon]);
      const stg = document.getElementById('stage');
      let tx = pt.x + 16, ty = pt.y - 14;
      if (tx + 260 > stg.clientWidth)  tx = pt.x - 270;
      if (ty + 160 > stg.clientHeight) ty = pt.y - 170;
      tp.style.left = tx + 'px';
      tp.style.top  = ty + 'px';
      tp.style.opacity = '1';
    });

    marker.on('mouseout', () => {
      document.getElementById('tip').style.opacity = '0';
    });

    // Click → Facility Card
    marker.on('click', e => {
      document.getElementById('tip').style.opacity = '0';
      openFacilityCard(ix, e.containerPoint);
    });

    marker.addTo(ixpLayer);
  });
}

// ─── FACILITY CARD (Protocol: facility cards feature) ──
function openFacilityCard(ix, pt) {
  const modal = document.getElementById('fc-modal');
  document.getElementById('fc-name').textContent = ix.name;
  document.getElementById('fc-sub').textContent  = `${ix.city}, ${ix.country} · FACILITY CARD`;

  // Turf.js: compute nearest other IXP
  const origin = turf.point([ix.lon, ix.lat]);
  const others = IXPs.filter(x => x.id !== ix.id);
  let nearestName = '—', nearestDist = Infinity;
  others.forEach(o => {
    const d = turf.distance(origin, turf.point([o.lon, o.lat]), {units:'kilometers'});
    if (d < nearestDist) { nearestDist = d; nearestName = o.name; }
  });

  // Traffic share
  const totalTraffic = IXPs.reduce((s,x) => s + x.traffic_peak_tbps, 0);
  const share = ((ix.traffic_peak_tbps / totalTraffic) * 100).toFixed(1);

  const rows = [
    {k:'Peak Traffic',   v: ix.traffic_peak_tbps + ' Tbps', bar: ix.traffic_peak_tbps/12.6},
    {k:'Member Networks',v: ix.member_count + '+'},
    {k:'Global Traffic Share', v: share + '%', bar: share/100},
    {k:'Tier',           v: 'Tier ' + ix.tier},
    {k:'Location',       v: `${ix.city}, ${ix.country}`},
    {k:'Website',        v: ix.website ? `<a href="${ix.website}" style="color:var(--cyan)">${ix.website.replace('https://','')}</a>` : '—'},
  ];

  document.getElementById('fc-rows').innerHTML = rows.map(r => `
    <div class="fc-row">
      <span class="fk">${r.k}</span>
      ${r.bar != null ? `<div class="fc-bar-wrap"><div class="fc-bar-fill" style="width:${Math.round(r.bar*100)}%"></div></div>` : ''}
      <span class="fv">${r.v}</span>
    </div>`).join('');

  document.getElementById('fc-turf').innerHTML =
    `<b style="color:var(--indigo)">Turf.js →</b> Nearest IXP: <b>${nearestName}</b> · ${Math.round(nearestDist).toLocaleString()} km`;

  const stg = document.getElementById('stage');
  let mx = pt.x + 14, my = pt.y - 20;
  if (mx + 295 > stg.clientWidth)  mx = pt.x - 295;
  if (my + 400 > stg.clientHeight) my = pt.y - 400;
  modal.style.left    = Math.max(8, mx) + 'px';
  modal.style.top     = Math.max(8, my) + 'px';
  modal.style.display = 'block';
}

function closeFacilityCard() {
  document.getElementById('fc-modal').style.display = 'none';
}

// ─── TURF.JS NEAREST IXP (mousemove) ────────────────
function turfNearest(latlng) {
  if (!IXPs.length || !turf) return;
  const pt = turf.point([latlng.lng, latlng.lat]);
  let minD = Infinity, minName = '—';
  IXPs.forEach(ix => {
    const d = turf.distance(pt, turf.point([ix.lon, ix.lat]), {units:'kilometers'});
    if (d < minD) { minD = d; minName = ix.name; }
  });
  document.getElementById('turf-dist').textContent =
    `${Math.round(minD).toLocaleString()} km → ${minName}`;
}

// ─── LAYER TOGGLES ──────────────────────────────────
function toggle(btn) {
  const k = btn.dataset.l;
  L_LAYERS[k] = !L_LAYERS[k];
  btn.classList.toggle('on', L_LAYERS[k]);
  switch(k) {
    case 'ixp':    L_LAYERS[k] ? ixpLayer.addTo(map)   : map.removeLayer(ixpLayer);   break;
    case 'cable':  L_LAYERS[k] ? cableLayer.addTo(map) : map.removeLayer(cableLayer); break;
    case 'bgp':    L_LAYERS[k] ? bgpLayer.addTo(map)   : map.removeLayer(bgpLayer);   break;
    case 't1':
      if (L_LAYERS[k]) { drawT1Paths(); t1Layer.addTo(map); }
      else map.removeLayer(t1Layer);
      break;
  }
}

// ─── ENTITY LIST (Section C) ────────────────────────
function buildEntityList() {
  const sorted = [...IXPs].sort((a,b) => b.traffic_peak_tbps - a.traffic_peak_tbps).slice(0, 7);
  const max    = sorted[0]?.traffic_peak_tbps || 1;
  const colors = [
    'linear-gradient(to right,#38BDF8,rgba(56,189,248,0.4))',
    'linear-gradient(to right,#38BDF8,rgba(56,189,248,0.35))',
    'linear-gradient(to right,#818CF8,rgba(129,140,248,0.5))',
    'linear-gradient(to right,#818CF8,rgba(129,140,248,0.4))',
    'linear-gradient(to right,#F59E0B,rgba(245,158,11,0.5))',
    'linear-gradient(to right,#F59E0B,rgba(245,158,11,0.4))',
    'linear-gradient(to right,#64748B,rgba(100,116,139,0.4))',
  ];
  document.getElementById('entity-list').innerHTML = sorted.map((ix, i) => `
    <div class="entity" onclick="flyToIXP(${ix.id})">
      <span class="en">${ix.name}</span>
      <div class="eb"><div class="ef" style="width:${Math.round(ix.traffic_peak_tbps/max*100)}%;background:${colors[i]||colors[6]}"></div></div>
      <span class="ep">${ix.traffic_peak_tbps} Tbps</span>
    </div>`).join('');
}

function flyToIXP(id) {
  const ix = IXPs.find(x => x.id === id);
  if (ix && map) map.flyTo([ix.lat, ix.lon], 5, { duration: 1.2 });
}

// ─── D3 CONCENTRATION DONUT CHART ───────────────────
function buildD3Chart() {
  const sorted    = [...IXPs].sort((a,b) => b.traffic_peak_tbps - a.traffic_peak_tbps);
  const top5      = sorted.slice(0,5);
  const othersSum = sorted.slice(5).reduce((s,x) => s + x.traffic_peak_tbps, 0);
  const data      = [...top5.map(x => ({label: x.name.split(' ')[0]+' '+x.name.split(' ')[1], value: x.traffic_peak_tbps})),
                     {label: 'All Others', value: othersSum}];

  const W = 230, H = 130, R = 52, innerR = 30;
  const colors = ['#38BDF8','#4FC3F7','#818CF8','#A5B4FC','#F59E0B','#374151'];

  const svg = d3.select('#d3-chart')
    .append('svg')
    .attr('width', W).attr('height', H)
    .style('overflow', 'visible');

  const g = svg.append('g').attr('transform', `translate(${H/2+8},${H/2})`);

  const pie   = d3.pie().value(d => d.value).sort(null);
  const arc   = d3.arc().innerRadius(innerR).outerRadius(R);
  const arcH  = d3.arc().innerRadius(innerR).outerRadius(R+5);

  const arcs  = g.selectAll('.arc').data(pie(data)).enter().append('g').attr('class','arc');

  arcs.append('path')
    .attr('d', arc)
    .attr('fill', (d,i) => colors[i])
    .attr('stroke', '#030712').attr('stroke-width', 1)
    .style('cursor','pointer')
    .on('mouseover', function(event, d) {
      d3.select(this).transition().duration(150).attr('d', arcH);
    })
    .on('mouseout', function(event, d) {
      d3.select(this).transition().duration(150).attr('d', arc);
    });

  // Center label
  g.append('text').attr('text-anchor','middle').attr('dy','-0.3em')
    .style('fill','#38BDF8').style('font-size','13px').style('font-weight','700')
    .style('font-family','Inter,sans-serif')
    .text((() => {
      const t = IXPs.reduce((s,x) => s + x.traffic_peak_tbps, 0);
      const t5 = top5.reduce((s,x) => s + x.traffic_peak_tbps, 0);
      return Math.round(t5/t*100) + '%';
    })());
  g.append('text').attr('text-anchor','middle').attr('dy','0.9em')
    .style('fill','#64748B').style('font-size','8px').style('font-family','Inter,sans-serif')
    .text('TOP 5 IXPs');

  // Legend
  const leg = svg.append('g').attr('transform', `translate(${H+12}, 10)`);
  data.forEach((d, i) => {
    const row = leg.append('g').attr('transform', `translate(0,${i*18})`);
    row.append('rect').attr('width',7).attr('height',7).attr('y',1)
       .attr('fill', colors[i]).attr('rx', 1);
    row.append('text').attr('x',12).attr('y',8)
       .style('fill','#64748B').style('font-size','8.5px').style('font-family','Inter,sans-serif')
       .text(`${d.label.length > 14 ? d.label.slice(0,14)+'…' : d.label} · ${d.value}T`);
  });
}

// ─── ASN TABLE (TanStack-style sortable) ──────────────
function buildASNTable() {
  let sorted = [...ASNs];
  const col = asnSort.col, dir = asnSort.dir;
  sorted.sort((a,b) => {
    const av = a[col] ?? a.prefixes_v4 ?? 0;
    const bv = b[col] ?? b.prefixes_v4 ?? 0;
    if (typeof av === 'string') return dir * av.localeCompare(bv);
    return dir * ((av||0) - (bv||0));
  });
  document.getElementById('asn-body').innerHTML = sorted.map(a => {
    const pfx  = a.prefixes_v4 || a.prefixes || 0;
    const tier = a.tier || 'T2';
    const isSel = selectedASN === a.asn;
    return `<div class="at-row${isSel?' sel':''}" onclick="selectASN(${a.asn})">
      <div class="ac">AS${a.asn}</div>
      <div class="ac" style="flex:2">${a.org || a.organization || '—'}</div>
      <div class="ac">${pfx ? (pfx/1000).toFixed(1)+'K' : '—'}</div>
      <div class="ac"><span class="badge ${tier==='T1'?'t1b':'t2b'}">${tier}</span></div>
    </div>`;
  }).join('');
}

function sortASN(col, el) {
  if (asnSort.col === col) asnSort.dir *= -1;
  else { asnSort.col = col; asnSort.dir = -1; }
  document.querySelectorAll('.ah').forEach(h => h.classList.remove('sort'));
  el.classList.add('sort');
  buildASNTable();
}

function selectASN(asn) {
  selectedASN = selectedASN === asn ? null : asn;
  buildASNTable();
}

// ─── SIMULATION ──────────────────────────────────────
function runSim() {
  simOn = !simOn;
  const btn = document.querySelector('.simbtn');
  const st  = document.getElementById('simst');
  const cv  = document.getElementById('sim-layer');
  const stg = document.getElementById('stage');

  if (simOn) {
    cv.width  = stg.clientWidth;
    cv.height = stg.clientHeight;
    simCtx    = cv.getContext('2d');
    btn.textContent = '■ STOP SIMULATION';
    btn.style.borderColor = 'rgba(245,158,11,0.5)';
    btn.style.color = 'var(--amber)';
    st.className = 'show';

    fetch('/api/simulate/failure?ixp_id=1')
      .then(r => r.json())
      .then(d => {
        st.innerHTML = `⚠ ${d.failed_node} OFFLINE — Impact: <b>${d.impact_level}</b><br>
          <span style="color:var(--muted)">~${(d.affected_routes_estimate||800000).toLocaleString()} routes affected
          · Re-convergence ~${d.bgp_reconvergence_estimate_sec||500}s
          · Rerouting via: ${(d.reroute_candidates||['AMS-IX','LINX']).join(', ')}</span>`;
      })
      .catch(() => {
        st.innerHTML = '⚠ DE-CIX FRANKFURT OFFLINE — BGP re-convergence in progress<br>'
          + '<span style="color:var(--muted)">~800K routes affected · Rerouting via AMS-IX, LINX, Netnod</span>';
      });

    simLoop();
  } else {
    if (simRAF) cancelAnimationFrame(simRAF);
    simCtx && simCtx.clearRect(0, 0, cv.width, cv.height);
    btn.textContent = '⚠ SIMULATE DE-CIX FRANKFURT FAILURE';
    btn.style.borderColor = 'rgba(239,68,68,0.45)';
    btn.style.color = 'var(--red)';
    st.className = '';
  }
}

function simLoop() {
  if (!simOn || !simCtx) return;
  const cv  = document.getElementById('sim-layer');
  const src = map.latLngToContainerPoint([50.11, 8.68]);

  simCtx.clearRect(0, 0, cv.width, cv.height);

  // Shockwave pulse
  const t = (Date.now() % 1400) / 1400;
  simCtx.beginPath();
  simCtx.arc(src.x, src.y, 10 + t * 75, 0, Math.PI * 2);
  simCtx.strokeStyle = `rgba(239,68,68,${0.85 * (1-t)})`;
  simCtx.lineWidth = 2.5;
  simCtx.stroke();

  // Reroute dashes
  const targets = [
    map.latLngToContainerPoint([52.37, 4.90]),
    map.latLngToContainerPoint([51.51, -0.09]),
    map.latLngToContainerPoint([59.33, 18.07]),
  ];
  const off = (Date.now() % 900) / 900;
  targets.forEach(dst => {
    simCtx.beginPath();
    simCtx.moveTo(src.x, src.y);
    simCtx.lineTo(dst.x, dst.y);
    simCtx.setLineDash([7, 4]);
    simCtx.lineDashOffset = -off * 22;
    simCtx.strokeStyle = 'rgba(239,68,68,0.6)';
    simCtx.lineWidth = 1.8;
    simCtx.stroke();
    simCtx.setLineDash([]);
  });

  // X mark
  simCtx.strokeStyle = '#EF4444'; simCtx.lineWidth = 2.5;
  simCtx.beginPath(); simCtx.moveTo(src.x-10,src.y-10); simCtx.lineTo(src.x+10,src.y+10); simCtx.stroke();
  simCtx.beginPath(); simCtx.moveTo(src.x+10,src.y-10); simCtx.lineTo(src.x-10,src.y+10); simCtx.stroke();

  simRAF = requestAnimationFrame(simLoop);
}

// ─── DOWNLOAD ────────────────────────────────────────
function download() { window.location.href = '/api/download/sample'; }

// ─── CLOCK ───────────────────────────────────────────
function tick() { document.getElementById('ts').textContent = new Date().toUTCString().slice(17,25) + ' UTC'; }
setInterval(tick, 1000); tick();

// ─── INIT ────────────────────────────────────────────
window.addEventListener('resize', () => {
  const cv = document.getElementById('sim-layer');
  const stg = document.getElementById('stage');
  cv.width  = stg.clientWidth;
  cv.height = stg.clientHeight;
});

fetchData();
</script>
