// ─── FETCH DATA ─────────────────────────────────────
async function fetchData() {
  let src = 'API';
  try {
    const [ixpRes, asnRes] = await Promise.all([fetch('/api/ixps'), fetch('/api/asns')]);
    if (!ixpRes.ok || !asnRes.ok) throw new Error();
    const ixpJson = await ixpRes.json();
    const asnJson = await asnRes.json();
    IXPs = ixpJson.ixps.filter(x => x.lat && x.lon);
    ASNs = asnJson.asns;
    const conc = ixpJson.intelligence?.concentration;
    if (conc) updateConcentration(conc.concentration_pct, conc.risk_level);
    try {
      const cabRes = await fetch('/api/cables');
      const cabJson = await cabRes.json();
      CABLES = cabJson.features.map(f => ({
        name:  f.properties.name,
        from:  [f.geometry.coordinates[0][1], f.geometry.coordinates[0][0]],
        to:    [f.geometry.coordinates[f.geometry.coordinates.length-1][1], f.geometry.coordinates[f.geometry.coordinates.length-1][0]],
        color: '#38BDF8', w: 2
      }));
    } catch { CABLES = MOCK_CABLES; }
  } catch {
    src = 'mock';
    IXPs   = MOCK_IXPS;
    ASNs   = MOCK_ASNS;
    CABLES = MOCK_CABLES;
    const total = IXPs.reduce((s,x) => s + x.traffic_peak_tbps, 0);
    const top5  = [...IXPs].sort((a,b) => b.traffic_peak_tbps - a.traffic_peak_tbps)
                            .slice(0,5).reduce((s,x) => s + x.traffic_peak_tbps, 0);
    updateConcentration(Math.round(top5/total*100), 'CRITICAL');
  }
  document.getElementById('api-src').innerHTML = `<span class="${src==='API'?'ok':'mock'}">${src}</span>`;
  document.getElementById('m-ixp').textContent  = IXPs.length + '+';
  buildMap();
  buildEntityList();
  buildD3Chart();
  buildASNTable();
  document.getElementById('loading').style.display = 'none';
}

function updateConcentration(pct, risk) {
  document.getElementById('m-conc').textContent    = pct + '%';
  document.getElementById('risk-label').textContent = risk;
  document.getElementById('risk-bar').style.width   = Math.min(pct, 100) + '%';
}

// ─── LEAFLET MAP ─────────────────────────────────────
function buildMap() {
  map = L.map('map', {
    center: [20, 10], zoom: 2, zoomControl: false,
    minZoom: 2, maxZoom: 10,
    preferCanvas: true
  });

  // OpenStreetMap tiles (dark-filtered via CSS)
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '', maxZoom: 18
  }).addTo(map);

  cableLayer = L.layerGroup().addTo(map);
  bgpLayer   = L.layerGroup().addTo(map);
  t1Layer    = L.layerGroup();
  ixpLayer   = L.layerGroup().addTo(map);

  drawCables();
  drawBGP();
  drawIXPs();

  // Turf.js: nearest IXP to map center on move
  map.on('mousemove', e => turfNearest(e.latlng));
}

// ─── DRAW CABLES (Leaflet polylines) ──────────────────
function drawCables() {
  cableLayer.clearLayers();
  CABLES.forEach(c => {
    // Use Turf.js to get great circle points
    const from = turf.point([c.from[1], c.from[0]]);
    const to   = turf.point([c.to[1],   c.to[0]]);
    const gc   = turf.greatCircle(from, to, { npoints: 80 });
    const latlngs = gc.geometry.coordinates.map(([lng,lat]) => [lat,lng]);
    L.polyline(latlngs, {
      color: c.color, weight: c.w, opacity: 1, smoothFactor: 1
    }).addTo(cableLayer);
  });
}

// ─── DRAW BGP BACKBONE ───────────────────────────────
function drawBGP() {
  bgpLayer.clearLayers();
  const links = [
    [[50.11,8.68],[52.37,4.90]], [[52.37,4.90],[51.51,-0.09]],
    [[50.11,8.68],[45.46,9.19]], [[50.11,8.68],[55.75,37.62]],
    [[50.11,8.68],[59.33,18.07]],[[40.71,-74.01],[41.88,-87.63]],
    [[40.71,-74.01],[34.05,-118.24]],[[41.88,-87.63],[34.05,-118.24]],
  ];
  links.forEach(([a,b]) => {
    L.polyline([a, b], {
      color: '#818CF8', weight: 1.5, opacity: 0.7, dashArray: '6 5'
    }).addTo(bgpLayer);
  });
}

// ─── DRAW T1 PATHS ────────────────────────────────────
function drawT1Paths() {
  t1Layer.clearLayers();
  const paths = [
    [[40.71,-74.01],[50.11,8.68]],
    [[40.71,-74.01],[35.69,139.69]],
    [[50.11,8.68],[1.35,103.82]],
  ];
