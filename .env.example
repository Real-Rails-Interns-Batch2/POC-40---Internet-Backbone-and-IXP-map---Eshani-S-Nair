# Real Rails — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Mapbox ──────────────────────────────────────────────
# Get your token at https://account.mapbox.com/
MAPBOX_TOKEN=pk.your_mapbox_token_here

# ── PeeringDB ────────────────────────────────────────────
# Optional — improves rate limits on /api/ixps
# Register at https://www.peeringdb.com/register
PEERINGDB_API_KEY=your_peeringdb_api_key_here

# ── App Settings ─────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=info

# ── Backend Server ───────────────────────────────────────
# Port that uvicorn listens on (used by Next.js proxy)
BACKEND_PORT=8000
