# Real Rails — Environment Variables (Document 4: Security Guardrail)
# Copy to .env and fill in your keys. NEVER commit .env to version control.

MAPBOX_TOKEN=pk.your_mapbox_token_here
PEERINGDB_API_KEY=your_peeringdb_api_key_here   # optional; improves rate limits
ENVIRONMENT=development
LOG_LEVEL=info
